{
    "family": "SolverBack",
    "containerDefinitions": [
      {
        "name": "BackSolver",
        "image": "891612557107.dkr.ecr.us-east-2.amazonaws.com/solver-repository:latest",
        "cpu": 256,  // CPU reservada para el contenedor (no 0)
        "memory": 512,  // Memoria reservada para el contenedor
        "portMappings": [
          {
            "containerPort": 8080,
            "hostPort": 8080,  // EC2 asignará un puerto automáticamente
            "protocol": "tcp"
          }
        ],
        "essential": true
      }
    ],
    "networkMode": "awsvpc",  // Modo correcto para EC2
    "requiresCompatibilities": ["EC2"],
    "cpu": "512",  // Máximo permitido en t2.micro (1 vCPU = 1024)
    "memory": "900",  // Máximo recomendado para t2.micro (1GB RAM)
    "executionRoleArn": "arn:aws:iam::891612557107:role/ecsTaskExecutionRole"
  }