{
    "family": "SolverBack",
    "containerDefinitions": [
      {
        "name": "BackSolver",
        "image": "891612557107.dkr.ecr.us-east-2.amazonaws.com/solver-repository:latest",
        "cpu": 256,
        "memory": 512,
        "portMappings": [
          {
            "containerPort": 8080,
            "hostPort": 8080,
            "protocol": "tcp"
          }
        ],
        "essential": true
      }
    ],
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["EC2"],
    "cpu": "512", 
    "memory": "900",
    "executionRoleArn": "arn:aws:iam::891612557107:role/ecsTaskExecutionRole"
  }
